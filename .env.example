# Local tests and default development database
DATABASE_URL=sqlite:///./ravn.db

# To use the existing Supabase PostgreSQL database, replace DATABASE_URL with
# the connection string from Supabase Connect. URL-encode special characters
# in the password. Never commit your real .env file or connection string.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

JWT_SECRET_KEY=replace-me
GITHUB_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
